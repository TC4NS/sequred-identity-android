# Copy this file to `keystore.properties` (which IS gitignored) and fill in
# the values. Generate the keystore once with:
#
#   keytool -genkey -v -keystore release.jks \
#       -alias sequred-identity -keyalg RSA -keysize 4096 \
#       -validity 36500 -storepass <strong-pass> -keypass <strong-pass> \
#       -dname "CN=Tucker Nelson,O=SeQured Identity,L=,ST=,C=US"
#
# Keep release.jks AND keystore.properties out of version control. If you
# lose the keystore you cannot push updates to the same Android app on
# Accrescent — only a new app entry.
#
# Alternatively set these as environment variables for CI:
#   SQ_STORE_FILE, SQ_STORE_PASSWORD, SQ_KEY_ALIAS, SQ_KEY_PASSWORD

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=sequred-identity
keyPassword=CHANGE_ME
