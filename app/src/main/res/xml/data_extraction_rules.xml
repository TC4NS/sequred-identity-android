<?xml version="1.0" encoding="utf-8"?>
<!-- Block both cloud backup and device-to-device transfer. Vault contents
     are encrypted at rest in app-private storage and must never leave the
     device through OS backup channels. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
