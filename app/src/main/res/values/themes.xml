<resources>
    <!-- App theme — kept minimal. Compose owns the actual look; this XML
         theme only needs to colour the system bars and supply the splash. -->
    <style name="Theme.SeQuredIdentity" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_black</item>
        <item name="windowSplashScreenAnimationDuration">350</item>
        <item name="postSplashScreenTheme">@style/Theme.SeQuredIdentity.PostSplash</item>
    </style>

    <style name="Theme.SeQuredIdentity.PostSplash" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/brand_black</item>
        <item name="android:navigationBarColor">@color/brand_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/brand_black</item>
    </style>

    <!-- Transparent + floating dialog look for the autofill overlay. The
         activity hosts a Compose sheet over a semi-opaque scrim; we don't
         want a full opaque window because that would obscure the calling
         app's login form during the interaction. -->
    <style name="Theme.SeQuredIdentity.AutofillOverlay" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
